# Universal Translator Backend Configuration

# Server host & port
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Translation provider: "auto", "google", "deepl", "libretranslate", "mymemory", "mock"
# Default is "auto", which uses credentials if provided, otherwise MyMemory with Mock fallback.
TRANSLATION_PROVIDER=auto

# Google Cloud Translation API credentials (optional)
# GOOGLE_TRANSLATE_API_KEY=your_google_cloud_api_key_here

# DeepL API credentials (optional)
# DEEPL_API_KEY=your_deepl_api_key_here
# DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# LibreTranslate self-hosted or public URL (optional)
# LIBRETRANSLATE_URL=https://libretranslate.de
# LIBRETRANSLATE_API_KEY=

# MyMemory contact email for higher daily quota (optional)
# MYMEMORY_EMAIL=user@example.com

# Request limits
MAX_TEXTS_PER_REQUEST=100
MAX_CHARS_PER_TEXT=5000
MAX_TOTAL_CHARS_PER_REQUEST=50000

# Rate limiting (requests per minute per IP)
RATE_LIMIT_RPM=120

# In-memory Caching
CACHE_ENABLED=true
CACHE_MAX_SIZE=10000
CACHE_TTL_SECONDS=86400
